{
  "version": "1.2.0",
  "language": "ru",
  "entries": [
    {
      "id": "TEO-TERM-001",
      "term": "Электрический ток",
      "definition": "Скорость переноса заряда через выбранное сечение; ампер равен кулону в секунду.",
      "topic_id": "teo_elements",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-002",
      "term": "Напряжение",
      "definition": "Разность электрических потенциалов выбранных точек; полярность отсчёта нужно указать.",
      "topic_id": "teo_elements",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-003",
      "term": "Мощность",
      "definition": "Скорость передачи или преобразования энергии. Мгновенная электрическая мощность при согласованных направлениях равна u·i.",
      "topic_id": "teo_elements",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-004",
      "term": "Шунт",
      "definition": "Резистор, падение напряжения на котором используют для оценки тока; его нагрев и влияние на цепь должны учитываться.",
      "topic_id": "teo_elements",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-005",
      "term": "Узел",
      "definition": "Соединение ветвей, в котором в сосредоточенной модели задаётся один потенциал.",
      "topic_id": "teo_dc_methods",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S03",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-006",
      "term": "Эквивалент Тевенина",
      "definition": "Линейная двухполюсная часть схемы, заменённая эквивалентным источником напряжения и последовательным импедансом.",
      "topic_id": "teo_dc_methods",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S03",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-007",
      "term": "Суперпозиция",
      "definition": "Расчёт линейного отклика как суммы откликов на отдельные воздействия; не универсальное правило для нелинейной мощности.",
      "topic_id": "teo_dc_methods",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S03",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-008",
      "term": "Зависимый источник",
      "definition": "Источник, величина которого определяется другим напряжением или током внутри модели.",
      "topic_id": "teo_dc_methods",
      "source_ids": [
        "TEO-S01",
        "TEO-S02",
        "TEO-S03",
        "TEO-S04"
      ]
    },
    {
      "id": "TEO-TERM-009",
      "term": "Фазор",
      "definition": "Комплексное представление амплитуды и фазы синусоиды одной заданной частоты.",
      "topic_id": "teo_ac",
      "source_ids": [
        "TEO-S04",
        "TEO-S05",
        "TEO-S06"
      ]
    },
    {
      "id": "TEO-TERM-010",
      "term": "Импеданс",
      "definition": "Комплексное отношение напряжения к току в линейном синусоидальном режиме.",
      "topic_id": "teo_ac",
      "source_ids": [
        "TEO-S04",
        "TEO-S05",
        "TEO-S06"
      ]
    },
    {
      "id": "TEO-TERM-011",
      "term": "Реактивная мощность",
      "definition": "Величина, описывающая реактивный обмен в синусоидальном режиме; не равна средней полезной энергии в секунду.",
      "topic_id": "teo_ac",
      "source_ids": [
        "TEO-S04",
        "TEO-S05",
        "TEO-S06"
      ]
    },
    {
      "id": "TEO-TERM-012",
      "term": "Резонанс",
      "definition": "Режим компенсации соответствующих реактивных составляющих; условия зависят от соединения элементов.",
      "topic_id": "teo_ac",
      "source_ids": [
        "TEO-S04",
        "TEO-S05",
        "TEO-S06"
      ]
    },
    {
      "id": "TEO-TERM-013",
      "term": "Взаимная индуктивность",
      "definition": "Коэффициент связи потокосцепления одной катушки с током другой в заданной линейной модели.",
      "topic_id": "teo_coupling",
      "source_ids": [
        "TEO-S07",
        "TEO-S09",
        "TEO-S23"
      ]
    },
    {
      "id": "TEO-TERM-014",
      "term": "Коэффициент связи",
      "definition": "Безразмерная мера общей магнитной связи; в принятом неотрицательном определении от 0 до 1.",
      "topic_id": "teo_coupling",
      "source_ids": [
        "TEO-S07",
        "TEO-S09",
        "TEO-S23"
      ]
    },
    {
      "id": "TEO-TERM-015",
      "term": "Точечная маркировка",
      "definition": "Обозначение одноимённых выводов связанных обмоток для согласования полярностей.",
      "topic_id": "teo_coupling",
      "source_ids": [
        "TEO-S07",
        "TEO-S09",
        "TEO-S23"
      ]
    },
    {
      "id": "TEO-TERM-016",
      "term": "Индуктивность рассеяния",
      "definition": "Часть модели, связанная с потоком, не сцепляющимся одинаково со всеми рассматриваемыми обмотками.",
      "topic_id": "teo_coupling",
      "source_ids": [
        "TEO-S07",
        "TEO-S09",
        "TEO-S23"
      ]
    },
    {
      "id": "TEO-TERM-017",
      "term": "Гармоника",
      "definition": "Синусоидальная составляющая периодического сигнала на целочисленной кратной основной частоте.",
      "topic_id": "teo_harmonics",
      "source_ids": [
        "TEO-S10",
        "TEO-S11",
        "TEO-S12",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-018",
      "term": "Действующее значение, RMS",
      "definition": "Корень из среднего квадрата сигнала; не равно его обычному среднему.",
      "topic_id": "teo_harmonics",
      "source_ids": [
        "TEO-S10",
        "TEO-S11",
        "TEO-S12",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-019",
      "term": "Коэффициент заполнения ШИМ",
      "definition": "Доля периода, в течение которой действует заданный активный уровень импульса.",
      "topic_id": "teo_harmonics",
      "source_ids": [
        "TEO-S10",
        "TEO-S11",
        "TEO-S12",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-020",
      "term": "Пик-фактор",
      "definition": "Отношение пикового модуля сигнала к его действующему значению; важно для ограничений измерительного прибора.",
      "topic_id": "teo_harmonics",
      "source_ids": [
        "TEO-S10",
        "TEO-S11",
        "TEO-S12",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-021",
      "term": "Четырёхполюсник",
      "definition": "Модель двух портов, связывающая их токи и напряжения при оговорённых условиях.",
      "topic_id": "teo_twoports_filters",
      "source_ids": [
        "TEO-S13",
        "TEO-S14",
        "TEO-S15",
        "TEO-S26"
      ]
    },
    {
      "id": "TEO-TERM-022",
      "term": "Полоса пропускания",
      "definition": "Диапазон частот, в котором фильтр удовлетворяет заданным ограничениям передачи; допускаемые изменения нужно указать.",
      "topic_id": "teo_twoports_filters",
      "source_ids": [
        "TEO-S13",
        "TEO-S14",
        "TEO-S15",
        "TEO-S26"
      ]
    },
    {
      "id": "TEO-TERM-023",
      "term": "Антиалиасинговый фильтр",
      "definition": "Ограничение спектра до дискретизации, уменьшающее наложение нежелательных частот на полезную полосу.",
      "topic_id": "teo_twoports_filters",
      "source_ids": [
        "TEO-S13",
        "TEO-S14",
        "TEO-S15",
        "TEO-S26"
      ]
    },
    {
      "id": "TEO-TERM-024",
      "term": "Характеристическое сопротивление звена",
      "definition": "Параметр согласованного режима; для симметричного взаимного звена выражается через его передающие параметры.",
      "topic_id": "teo_twoports_filters",
      "source_ids": [
        "TEO-S13",
        "TEO-S14",
        "TEO-S15",
        "TEO-S26"
      ]
    },
    {
      "id": "TEO-TERM-025",
      "term": "Фазное напряжение",
      "definition": "В данном банке — напряжение ветви нагрузки либо явно указанное напряжение фаза–нейтраль источника; контекст нужно читать.",
      "topic_id": "teo_threephase",
      "source_ids": [
        "TEO-S01",
        "TEO-S16",
        "TEO-S17",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-026",
      "term": "Линейное напряжение",
      "definition": "Напряжение между двумя линейными проводниками.",
      "topic_id": "teo_threephase",
      "source_ids": [
        "TEO-S01",
        "TEO-S16",
        "TEO-S17",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-027",
      "term": "Плавающая нейтраль",
      "definition": "Нейтральная точка нагрузки без жёсткой связи с опорной нейтралью источника; её потенциал определяется балансом токов.",
      "topic_id": "teo_threephase",
      "source_ids": [
        "TEO-S01",
        "TEO-S16",
        "TEO-S17",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-028",
      "term": "Обратная последовательность",
      "definition": "Симметричная тройка фазоров с порядком вращения, обратным выбранной прямой последовательности.",
      "topic_id": "teo_threephase",
      "source_ids": [
        "TEO-S01",
        "TEO-S16",
        "TEO-S17",
        "TEO-S18"
      ]
    },
    {
      "id": "TEO-TERM-029",
      "term": "ВАХ",
      "definition": "Вольт-амперная характеристика: зависимость тока от напряжения при заданных условиях.",
      "topic_id": "teo_nonlinear_dc",
      "source_ids": [
        "TEO-S01",
        "TEO-S19"
      ]
    },
    {
      "id": "TEO-TERM-030",
      "term": "Рабочая точка",
      "definition": "Установившаяся пара напряжения и тока, согласующая характеристику элемента и внешнюю цепь.",
      "topic_id": "teo_nonlinear_dc",
      "source_ids": [
        "TEO-S01",
        "TEO-S19"
      ]
    },
    {
      "id": "TEO-TERM-031",
      "term": "Нагрузочная прямая",
      "definition": "Графическое уравнение ограничений внешней линейной цепи в координатах напряжение–ток.",
      "topic_id": "teo_nonlinear_dc",
      "source_ids": [
        "TEO-S01",
        "TEO-S19"
      ]
    },
    {
      "id": "TEO-TERM-032",
      "term": "Дифференциальное сопротивление",
      "definition": "Локальная производная dU/dI; используется для малых отклонений около заданной точки.",
      "topic_id": "teo_nonlinear_dc",
      "source_ids": [
        "TEO-S01",
        "TEO-S19"
      ]
    },
    {
      "id": "TEO-TERM-033",
      "term": "Магнитная индукция B",
      "definition": "Плотность магнитного потока, измеряется в теслах.",
      "topic_id": "teo_magnetics",
      "source_ids": [
        "TEO-S20",
        "TEO-S21",
        "TEO-S22",
        "TEO-S25"
      ]
    },
    {
      "id": "TEO-TERM-034",
      "term": "Магнитодвижущая сила",
      "definition": "Возбуждение магнитной цепи; для катушки задаётся ампер-витками NI.",
      "topic_id": "teo_magnetics",
      "source_ids": [
        "TEO-S20",
        "TEO-S21",
        "TEO-S22",
        "TEO-S25"
      ]
    },
    {
      "id": "TEO-TERM-035",
      "term": "Остаточная индукция Br",
      "definition": "Индукция в материале при H = 0 на соответствующей ветви характеристики после намагничивания.",
      "topic_id": "teo_magnetics",
      "source_ids": [
        "TEO-S20",
        "TEO-S21",
        "TEO-S22",
        "TEO-S25"
      ]
    },
    {
      "id": "TEO-TERM-036",
      "term": "Магнитное насыщение",
      "definition": "Область характеристики с существенно меньшим приращением B на приращение H по сравнению с областью высокой проницаемости.",
      "topic_id": "teo_magnetics",
      "source_ids": [
        "TEO-S20",
        "TEO-S21",
        "TEO-S22",
        "TEO-S25"
      ]
    },
    {
      "id": "TEO-TERM-037",
      "term": "Ветвь намагничивания",
      "definition": "Часть эквивалентной схемы, описывающая возбуждение магнитного потока; реальная характеристика может быть нелинейной.",
      "topic_id": "teo_nonlinear_ac",
      "source_ids": [
        "TEO-S08",
        "TEO-S09",
        "TEO-S10",
        "TEO-S22",
        "TEO-S23",
        "TEO-S24",
        "TEO-S27"
      ]
    },
    {
      "id": "TEO-TERM-038",
      "term": "Баланс вольт-секунд",
      "definition": "Нулевой интеграл напряжения на магнитной ветви за период, необходимый для повторения её потока в принятой модели.",
      "topic_id": "teo_nonlinear_ac",
      "source_ids": [
        "TEO-S08",
        "TEO-S09",
        "TEO-S10",
        "TEO-S22",
        "TEO-S23",
        "TEO-S24",
        "TEO-S27"
      ]
    },
    {
      "id": "TEO-TERM-039",
      "term": "Ток насыщения Isat",
      "definition": "Паспортный ток при установленном критерии изменения индуктивности; критерий и условия нужно читать.",
      "topic_id": "teo_nonlinear_ac",
      "source_ids": [
        "TEO-S08",
        "TEO-S09",
        "TEO-S10",
        "TEO-S22",
        "TEO-S23",
        "TEO-S24",
        "TEO-S27"
      ]
    },
    {
      "id": "TEO-TERM-040",
      "term": "Холостой ход трансформатора",
      "definition": "Режим без нагрузки вторичной стороны; первичный ток и потери у реального трансформатора могут сохраняться.",
      "topic_id": "teo_nonlinear_ac",
      "source_ids": [
        "TEO-S08",
        "TEO-S09",
        "TEO-S10",
        "TEO-S22",
